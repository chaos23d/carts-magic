      m_Calls: []
  m_text: "\u041F\u0440\u0438\u0432\u0435\u0442, \u0442\u044B \u0445\u043E\u0447\u0435\u0448\u044C
    \u0441\u0438\u043B\u044B? \u043C\u043E\u0433\u0443 \u0442\u0435\u0431\u0435 \u0432
    \u044D\u0442\u043E\u043C \u043F\u043E\u043C\u043E\u0447\u044C\n\u041F\u0440\u043E\u0441\u0442\u043E
    \u043F\u043E\u043B\u043E\u0436\u0438 \u043B\u044E\u0431\u043E\u0439 \u0430\u0440\u0442\u0435\u0444\u0430\u043A\u0442
    \u043D\u0430 \u0440\u0438\u0442\u0443\u0430\u043B\u044C\u043D\u0443\u044E \u043A\u043B\u0435\u0442\u043A\u0443
    \u0438 \u0442\u044B \u043F\u043E\u043B\u0443\u0447\u0438\u0448\u044C \u0434\u043E\u043F\u043E\u043B\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0435
    \u0437\u0434\u043E\u0440\u043E\u0432\u044C\u0435\n\n\u0420\u0430\u0437\u043C\u0435\u0440
    \u0437\u0434\u043E\u0440\u043E\u0432\u044C\u044F \u0437\u0430\u0432\u0438\u0441\u0438\u0442
    \u043E\u0442 \u0441\u0430\u043C\u043E\u0433\u043E \u0430\u0440\u0442\u0435\u0444\u0430\u043A\u0442\u0430\n"
