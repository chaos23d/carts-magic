  m_FontData:
    m_Font: {fileID: 12800000, guid: 22d08fa7789a4d8498553da358025d06, type: 3}
    m_FontSize: 14
    m_FontStyle: 0
    m_BestFit: 1
    m_MinSize: 10
    m_MaxSize: 158
    m_Alignment: 4
    m_AlignByGeometry: 0
    m_RichText: 1
    m_HorizontalOverflow: 0
    m_VerticalOverflow: 0
    m_LineSpacing: 1
  m_Text: "\u0414\u043B\u042F \u0418\u0421\u041F\u041E\u041B\u042C\u0417\u041E\u0412\u0410\u041D\u0418\u042F
    \u043E\u0431\u044B\u0447\u043D\u044B\u0445 \u041A\u0410\u0420\u0422 \u0441\u043D\u0430\u0447\u0430\u043B\u0430
    \u0432\u044B\u0431\u0435\u0440\u0438\u0442\u0435 \u0435\u0451 (\u0438\u043B\u0438
    \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E \u0432 \u043A\u043E\u043C\u0431\u0438\u043D\u0430\u0446\u0438\u0438),
    \u0430 \u0437\u0430\u0442\u0435\u043C \u043D\u0430\u043F\u0440\u0430\u0432\u044C\u0442\u0435
    \u043D\u0430 \u0446\u0435\u043B\u044C\n\n \u0421\u0442\u0430\u043D\u0434\u0430\u0440\u0442\u043D\u0430\u044F
    \u0434\u0430\u043B\u044C\u043D\u043E\u0441\u0442\u044C \u043F\u0440\u0438\u043C\u0435\u043D\u0435\u043D\u0438\u044F
    - 3 \u043A\u043B\u0435\u0442\u043A\u0438\n \u041F\u0435\u0440\u0435\u043C\u0435\u0449\u0430\u0439\u0442\u0435
    \u043A\u0430\u043C\u0435\u0440\u0443, \u0435\u0441\u043B\u0438 \u043D\u0435 \u0432\u0438\u0434\u0438\u0442\u0435
    \u0432\u0441\u044E \u043E\u0431\u043B\u0430\u0441\u0442\u044C"
