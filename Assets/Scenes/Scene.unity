  m_text: "\u041F\u0440\u0438\u0432\u0435\u0442, \u0442\u044B \u0445\u043E\u0447\u0435\u0448\u044C
    \u0441\u0438\u043B\u044B? \u043C\u043E\u0433\u0443 \u0442\u0435\u0431\u0435 \u0432
    \u044D\u0442\u043E\u043C \u043F\u043E\u043C\u043E\u0447\u044C\n\u041F\u0440\u043E\u0441\u0442\u043E
    \u043F\u043E\u043B\u043E\u0436\u0438 \u043B\u044E\u0431\u043E\u0439 \u0430\u0440\u0442\u0435\u0444\u0430\u043A\u0442
