  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\u0410 \u044F \u0432\u0438\u0436\u0443 \u0442\u044B \u0443\u043C\u0435\u043B\u044B\u0439
    \u043C\u0430\u0433, \u0445\u043E\u0442\u044F \u0442\u044B \u0432\u0440\u044F\u0434
    \u043B\u0438 \u0441\u043C\u043E\u0436\u0435\u0448\u044C \u0432\u044B\u0436\u0438\u0442\u044C
    \u0432 \u043F\u0440\u043E\u043A\u043B\u044F\u0442\u044B\u0445 \u043F\u0435\u0449\u0435\u0440\u0430\u0445,
    \u043E\u0431\u0438\u0442\u0435\u043B\u044C \u0434\u0435\u0440\u043B\u043E\u0440\u0433\u043E\u0432,
    \u043D\u043E \u0442\u0430\u043A \u0438 \u0431\u044B\u0442\u044C \u044F \u0442\u0435\u0431\u0435
    \u043F\u043E\u043C\u043E\u0433\u0443 \u0442\u0443\u0434\u0430 \u043F\u043E\u043F\u0430\u0441\u0442\u044C\n\u041F\u043E\u0434\u043E\u0439\u0434\u0438
    \u043A\u043E \u043C\u043D\u0435 \u0438 \u044F \u0432 \u0446\u0435\u043D\u0442\u0440\u0435
    \u043E\u0442\u043A\u0440\u043E\u044E \u043F\u0440\u043E\u0445\u043E\u0434. \u041D\u0435
    \u0434\u0443\u043C\u0430\u044E, \u0447\u0442\u043E \u0442\u044B\u043C \u0442\u0430\u043C
    \u0434\u043E\u043B\u0433\u043E \u043F\u0440\u043E\u0442\u044F\u043D\u0435\u0448\u044C"
  m_isRightToLeft: 0
