  type: 85
  name: 
  name_real: "\u043A\u0430\u0440\u0442\u0430 \u0432\u0435\u043B\u0438\u043A\u043E\u0433\u043E
    \u043F\u043E\u0436\u0438\u0440\u0430\u0442\u0435\u043B\u044F"
  col: 1
  infa: "\u0421\u0435\u0439\u0447\u0430\u0441 \u043A\u0430\u0440\u0442\u0430 \u0441\u043F\u0438\u0442.|
    \u041F\u0440\u0438 \u043F\u0440\u0438\u043C\u0435\u043D\u0435\u043D\u0438\u0438
    \u043A\u0430\u0440\u0442\u0430 \u0434\u043E\u0431\u0430\u0432\u043B\u044F\u0435\u0442\u0441\u044F
    \u0432 \u043A\u043E\u043B\u043E\u0434\u0443 \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0430
    \u0438 \u043F\u043E\u0433\u043B\u043E\u0449\u0430\u0435\u0442 \u044D\u043D\u0435\u0440\u0433\u0438\u044E
    \u043A\u0430\u0440\u0442.|\u041D\u0435 \u0442\u0440\u0430\u0442\u0438\u0442 \u0445\u043E\u0434
    \u043F\u0440\u0438 \u043F\u0440\u0438\u043C\u0435\u043D\u0435\u043D\u0438\u0438"
  sum_comb_other: 1
  spetial: 1
  open: 1
