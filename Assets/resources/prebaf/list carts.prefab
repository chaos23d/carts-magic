  m_Name: 
  m_EditorClassIdentifier: 
  lvl: 3
  type: 28
  name: 
  name_real: "\u043A\u0430\u0440\u0442\u0430 \u043E\u0433\u043D\u0435\u043D\u043D\u043E\u0433\u043E
    \u0434\u0443\u0445\u0430(\u0430\u0440\u0442\u0435\u0444\u0430\u043A\u0442)"
  col: 1
  infa: "\u043F\u0440\u0435\u0432\u0440\u0430\u0449\u0430\u0435\u0442 \u0432\u043B\u0430\u0434\u0435\u043B\u044C\u0446\u0430
    \u043A\u0430\u0440\u0442\u044B \u0432 \u043E\u0433\u043D\u0435\u043D\u043D\u043E\u0433\u043E
    \u0434\u0443\u0445\u0430.|\u043B\u044E\u0431\u0430\u044F \u043A\u0430\u0440\u0442\u0430-\u044D\u043B\u0435\u043C\u0435\u043D\u0442
    \u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u0441\u044F \u043E\u0433\u043D\u0435\u043D\u043D\u043E\u0439
    \u043F\u0440\u0438 \u043F\u0440\u0438\u043C\u0435\u043D\u0435\u043D\u0438\u0438.|\u041B\u044E\u0431\u043E\u0439
    \u043E\u0433\u043D\u0435\u043D\u043D\u044B\u0439 \u044D\u0444\u0444\u0435\u043A\u0442
    \u043F\u043E\u0433\u043B\u043E\u0449\u0430\u0435\u0442\u0441\u044F \u0432 \u0432\u0438\u0434\u0435
    \u0437\u0434\u043E\u0440\u043E\u0432\u044C\u044F(\u0432 \u0440\u0430\u0437\u043C\u0435\u0440\u0435
    \u043C\u043E\u0449\u0438 \u044D\u0444\u0444\u0435\u043A\u0442\u0430)"
