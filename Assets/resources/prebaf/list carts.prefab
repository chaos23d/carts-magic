  m_Name: 
  m_EditorClassIdentifier: 
  lvl: 2
  type: 23
  name: 
  name_real: "\u044F\u0434\u043E\u0432\u0438\u0442\u0430\u044F \u043A\u0430\u0440\u0442\u0430
    \u0433\u0435\u043D\u0435\u0440\u0430\u0446\u0438\u0438(\u0430\u0440\u0442\u0435\u0444\u0430\u043A\u0442)"
  col: 1
  infa: "\u0421\u043E\u0437\u0434\u0430\u0451\u0442 \u044F\u0434\u043E\u0432\u0438\u0442\u0443\u044E
    \u043A\u0430\u0440\u0442\u0443 \u043C\u043E\u0449\u043D\u043E\u0441\u0442\u0438
    2 \u0438 \u0434\u043E\u0431\u0430\u0432\u043B\u044F\u0435\u0442 \u0432 \u0438\u043D\u0432\u0435\u043D\u0442\u0430\u0440\u044C|
    +1 \u043A \u043C\u0435\u0441\u0442\u0443 \u0432 \u0438\u043D\u0432\u0435\u043D\u0442\u0430\u0440\u0435
    \u0434\u043B\u044F \u044F\u0434\u043E\u0432\u0438\u0442\u043E\u0439 \u043A\u0430\u0440\u0442\u044B
    \u043C\u043E\u0449\u043D\u043E\u0441\u0442\u0438 2"
  sum_comb_other: 1
  spetial: 0
  open: 1
  perez: 10
  perez_now: 10
  q: 0
  q_max: 0
  q_sum: 1
  type_q_now: 0
  first: 1
