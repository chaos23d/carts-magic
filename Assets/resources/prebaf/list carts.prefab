  m_EditorClassIdentifier: 
  lvl: 1
  type: 77
  name: 
  name_real: "\u043A\u0430\u0440\u0442\u0430 \u0448\u0430\u043C\u0430\u043D\u0430(\u0430\u0440\u0442\u0435\u0444\u0430\u043A\u0442
    \u0431\u043E\u0441\u0441\u0430)"
  col: 1
  infa: "\u041F\u0440\u0438 \u043F\u0440\u0438\u043C\u0435\u043D\u0435\u043D\u0438\u0438
    \u043A\u0430\u0440\u0442\u044B-\u0435\u043B\u0435\u043C\u0435\u043D\u0442\u0430
    \u043D\u0430 \u0441\u0432\u043E\u0431\u043E\u0434\u043D\u0443\u044E \u043A\u043B\u0435\u0442\u043A\u0443
    \u0442\u0440\u0430\u0442\u0438\u0442 \u0437\u0430\u0440\u044F\u0434 \u0438 \u0441\u043E\u0437\u0434\u0430\u0451\u0442
    \u0434\u0443\u0445\u0430-\u0435\u043B\u0435\u043C\u0435\u043D\u0442\u0430\u043B\u0430|\u042D\u0442\u043E\u0442
    \u0434\u0443\u0445 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0435\u0442
    \u043A\u0430\u0440\u0442\u0443-\u044D\u043B\u0435\u043C\u0435\u043D\u0442 \u043D\u0430
    \u0442\u0443 \u0436\u0435 \u043A\u043B\u0435\u0442\u043A\u0443, \u043A\u043E\u0433\u0434\u0430
    \u0432\u043B\u0430\u0434\u0435\u043B\u0435\u0446 \u043F\u0440\u0438\u043C\u0435\u043D\u044F\u0435\u0442
    \u0441\u043E\u043E\u0442\u0432\u0435\u0441\u0442\u0432\u0443\u044E\u0449\u0443\u044E
    \u043A\u0430\u0440\u0442\u0443"
